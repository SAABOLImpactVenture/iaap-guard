{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saabol.example/schemas/iaap-guard/product-manifest.schema.json",
  "title": "IaaP Guard Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "repositories"],
  "properties": {
    "schemaVersion": {"const": "iaap-product/v1"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "roles"],
        "properties": {
          "name": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "product-contract",
                "experience",
                "control-plane",
                "governance",
                "evidence",
                "integration",
                "implementation",
                "other"
              ]
            }
          },
          "required": {"type": "boolean", "default": true},
          "primary": {"type": "boolean", "default": false}
        }
      }
    }
  }
}
