{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saabol.example/schemas/iaap-guard/product-planning-report.schema.json",
  "title": "IaaP Guard Product Planning Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planningCatalogVersion", "status", "source", "totals", "objectives", "boundary"],
  "properties": {
    "schemaVersion": {"const": "product-planning-report/v1"},
    "planningCatalogVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["improvement-required", "no-current-findings"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "evidenceRevision", "productConclusion", "overallScore", "minimumMemberScore", "registeredRepositories", "presentRepositories"],
      "properties": {
        "product": {"type": "object"},
        "evidenceRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "productConclusion": {"enum": ["success", "neutral", "failure", "incomplete"]},
        "overallScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "minimumMemberScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "registeredRepositories": {"type": "integer", "minimum": 1},
        "presentRepositories": {"type": "integer", "minimum": 0}
      }
    },
    "totals": {"type": "object"},
    "objectives": {"type": "array", "items": {"type": "object"}},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory", "candidateBacklogOnly", "doesNotExecuteWork", "doesNotManageSprints", "doesNotExpandGitHubAppPermissions"],
      "properties": {
        "advisory": {"const": true},
        "candidateBacklogOnly": {"const": true},
        "doesNotExecuteWork": {"const": true},
        "doesNotManageSprints": {"const": true},
        "doesNotExpandGitHubAppPermissions": {"const": true}
      }
    }
  }
}
